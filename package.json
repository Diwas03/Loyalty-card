{
  "name": "coffee-loyalty-pilot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "worker": "tsx src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "staff-password": "tsx scripts/staff-password.ts",
    "staff-account": "tsx scripts/staff-account.ts",
    "backup": "tsx scripts/backup.ts",
    "staff-disable": "tsx scripts/staff-disable.ts",
    "test:browser": "node scripts/run-tests.mjs browser",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start:production": "node dist/server.js",
    "worker:production": "node dist/worker.js",
    "test:hosted": "node scripts/run-tests.mjs hosted",
    "hosted:schema": "tsx scripts/hosted-schema.ts",
    "hosted:staff": "tsx scripts/hosted-staff.ts",
    "hosted:import": "tsx scripts/import-sqlite.ts",
    "hosted:configure": "tsx scripts/configure-hosted.ts",
    "local": "node scripts/local.mjs",
    "local:staff": "node scripts/local.mjs staff",
    "local:stop": "node scripts/local.mjs stop",
    "test:ui": "node tests/ui-smoke.mjs",
    "test:pwa": "node tests/pwa-smoke.mjs",
    "test:scanner": "node scripts/run-tests.mjs scanner",
    "wallet:check": "node scripts/check-google-wallet.mjs"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.1",
    "@zxing/browser": "^0.2.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "passkit-generator": "^3.7.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "playwright": "^1.64.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "version": "0.3.0"
}
