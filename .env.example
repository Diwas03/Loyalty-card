# Copy to .env; never commit actual credentials. Run npm run staff-password locally.
PORT=3000
STAFF_PASSWORD_HASH=
# Leave blank for local-only browser testing. Real wallets require a stable public HTTPS origin.
PUBLIC_BASE_URL=
# Keep false for HTTPS: share the private /?member=... customer URL instead of exposing the seed.
DEMO_PUBLIC_CUSTOMER=false

# Google Wallet: values/paths only in your local .env or secure runtime configuration.
GOOGLE_ISSUER_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=

# Google is the default. Apple is retained as an optional separate integration.
APPLE_WALLET_ENABLED=false

# Apple Wallet: PEM file paths; store private material outside version control.
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_CERT_FILE=
APPLE_KEY_FILE=
APPLE_WWDR_FILE=
APPLE_KEY_PASSPHRASE=

# Hosted mode: Vercel + Supabase. These are SERVER-ONLY; never prefix with NEXT_PUBLIC_ or VITE_.
DATABASE_URL=
# Use the PostgreSQL URI from Connect > Transaction pooler, not the HTTPS API URL.
# Example only; replace all placeholders securely and percent-encode special password characters:
# postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres
# Optional Supabase CA certificate PEM if required by the verified TLS chain. Never disable verification.
DATABASE_CA_CERT=
# Entire service-account JSON goes only into Vercel's encrypted environment settings, not Git.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Random 32+ character token, shared securely between Vercel and Supabase Vault for retry jobs.
CRON_SECRET=
# Local-only deployment behind exactly one trusted proxy; not needed on Vercel.
TRUST_PROXY_HOPS=
