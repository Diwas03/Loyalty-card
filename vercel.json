{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "supabase/{schema,shops,referrals}.sql"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/wallet/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/shop-qr.png",
      "destination": "/api/index"
    },
    {
      "source": "/healthz",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/wallet-updates",
      "schedule": "0 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/login.html",
      "destination": "/business/login.html",
      "permanent": false
    },
    {
      "source": "/register.html",
      "destination": "/business/register.html",
      "permanent": false
    },
    {
      "source": "/staff.html",
      "destination": "/business/dashboard.html",
      "permanent": false
    }
  ]
}
